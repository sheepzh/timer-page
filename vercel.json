{
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "wfhg.cc"
                }
            ],
            "destination": "https://time-tracker-4-browser.app/:path*",
            "statusCode": 301
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "www.wfhg.cc"
                }
            ],
            "destination": "https://time-tracker-4-browser.app/:path*",
            "statusCode": 301
        },
        {
            "source": "/:lang(en|zh_CN|zh_TW|de|fr|es|pt_PT|ja|ru|uk)/blog/:slug/",
            "destination": "/:lang/blog/:slug",
            "permanent": true
        },
        {
            "source": "/:lang(en|zh_CN|zh_TW|de|fr|es|pt_PT|ja|ru|uk)/:page(faq|privacy|install)/",
            "destination": "/:lang/:page",
            "permanent": true
        },
        {
            "source": "/:lang(en|zh_CN|zh_TW|de|fr|es|pt_PT|ja|ru|uk)/guide/:page(start|data)/",
            "destination": "/:lang/guide/:page",
            "permanent": true
        },
        {
            "source": "/:lang(en|zh_CN|zh_TW|de|fr|es|pt_PT|ja|ru|uk)/guide/basic/:page(stat|analysis|limit)/",
            "destination": "/:lang/guide/basic/:page",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/",
            "destination": "/en"
        }
    ],
    "cleanUrls": true
}